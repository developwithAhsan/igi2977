{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "igi2977",
  "main": "worker.js",
  "compatibility_date": "2026-11-04",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
